APP_NAME=부꾸 API
APP_ENV=development
DEBUG=false

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna


# 공유 주소·APK 주소 결정 후 설정한다. 미설정 시 내 부적 저장·조회는 계속 사용 가능하다.
# AMULET_SHARE_BASE_URL=https://your-share-domain.example
# AMULET_APK_DOWNLOAD_URL=https://your-apk-download.example

# 서버에 배포한 서명 APK 파일 경로. Render 임시 디스크 대신 배포 산출물/영속 저장소 사용.
# AMULET_APK_FILE_PATH=/srv/releases/bukku.apk
# 파일 경로 대신 위 AMULET_APK_DOWNLOAD_URL로 외부 파일 저장소를 연결할 수도 있다.
# ANDROID_PACKAGE_NAME=프론트에서 받은 실제 패키지명
# ANDROID_SHA256_CERT_FINGERPRINTS=["프론트에서 받은 콜론 구분 SHA-256 지문"]
# 공유 주소의 /share/{token} 응답은 JSON이다. 설치 안내 화면은 프론트에서 구현한다.
